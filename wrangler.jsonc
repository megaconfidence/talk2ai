/**
 * For more details on how to configure Wrangler, refer to:
 * https://developers.cloudflare.com/workers/wrangler/configuration/
 */
{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "talk2ai",
	"main": "src/index.ts",
	"compatibility_date": "2025-03-17",
	"compatibility_flags": ["nodejs_compat"],
	/**
	 * Declarative Durable Object lifecycle. This replaces the legacy `migrations`
	 * array (the two are mutually exclusive) specifically so this repo can be
	 * deployed to a fresh account.
	 *
	 * The old array started with `new_classes: ["MyDurableObject"]`, which asks
	 * for the key-value storage backend. Cloudflare no longer allows creating
	 * key-value-backed namespaces on accounts that do not already have one, and
	 * the Workers Free plan has never supported them — so a first-time deploy
	 * would have failed on that step before reaching anything else.
	 *
	 * With `exports` there is no history to replay: only what is declared here
	 * gets provisioned.
	 */
	"exports": {
		"VoiceAgent": {
			"storage": "sqlite",
			"type": "durable-object",
		},
	},
	"assets": {
		"binding": "ASSETS",
		"directory": "./public",
	},
	"durable_objects": {
		"bindings": [
			{
				"class_name": "VoiceAgent",
				"name": "VoiceAgent",
			},
		],
	},
	"observability": {
		"enabled": true,
	},
	"ai": {
		"binding": "AI",
	},
	/**
	 * Smart Placement
	 * Docs: https://developers.cloudflare.com/workers/configuration/smart-placement/#smart-placement
	 */
	// "placement": { "mode": "smart" },

	/**
	 * Bindings
	 * Bindings allow your Worker to interact with resources on the Cloudflare Developer Platform, including
	 * databases, object storage, AI inference, real-time communication and more.
	 * https://developers.cloudflare.com/workers/runtime-apis/bindings/
	 */

	/**
	 * Environment Variables
	 * https://developers.cloudflare.com/workers/wrangler/configuration/#environment-variables
	 */
	// "vars": { "MY_VARIABLE": "production_value" },
	/**
	 * Note: Use secrets to store sensitive data.
	 * https://developers.cloudflare.com/workers/configuration/secrets/
	 */

	/**
	 * Static Assets
	 * https://developers.cloudflare.com/workers/static-assets/binding/
	 */
	// "assets": { "directory": "./public/", "binding": "ASSETS" },

	/**
	 * Service Bindings (communicate between multiple Workers)
	 * https://developers.cloudflare.com/workers/wrangler/configuration/#service-bindings
	 */
	// "services": [{ "binding": "MY_SERVICE", "service": "my-service" }]
}
